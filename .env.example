POSTGRES_PASSWORD=change-me-for-local-development
# Optional locally (a temporary key is generated); required in production, at least 32 bytes.
JWT_SECRET=
# Required in production. Development accepts localhost:5173 and 127.0.0.1:5173.
FRONTEND_ORIGIN=
# New registrations receive a trial of this many days (1-90).
TRIAL_DAYS=14
# Local testing only: print one-time links to backend logs. Never enable for real accounts.
DEV_AUTH_LINKS=true
RESEND_API_KEY=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
